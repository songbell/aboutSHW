namespace KERNEL_NAME {

// Experimental sandbox copy of pa_small_q_ov.cm.
// Keep stability-oriented changes in pa_small_q_ov.cm and stage more invasive
// register-pressure / scheduling experiments in this file.

// pa_small_q: per-(tile, head-chunk, kv-partition) decode kernel.
//
// Adapted from pa_single_token to handle q_len > 1 within a subsequence — the
// spec-decoding / draft-validation case where one sequence carries `spec_num`
// query tokens (e.g. q_len=16) against a long past KV. multi_token's WG
// utilisation collapses to 1/16 in this shape.
//
// TILE_Q optimisation: each SG packs TILE_Q q-tokens of the same subsequence
// so K/V loads are amortised across the spec window and DPAS RepeatCount stays
// saturated at Q_head_chunk_size * TILE_Q (≤ 8). Mapping is host-packed as i32
// triples (orig_seq_idx, q_start_in_subseq, valid_count); valid_count is in the
// range [1, TILE_Q] and equals TILE_Q for full tiles. Tail tiles (valid_count <
// TILE_Q) write neutral output (lse = -inf) for the dummy rows so finalize can
// safely reduce a fixed-size partition buffer.
//
// Layout invariants:
//   selected_q_mapping  : i32 triples, length = 3 * tile_count
//   output              : f32 [tile_count * TILE_Q, head, partition, head_size]
//   lse                 : f32 [tile_count * TILE_Q, head, partition]
//   Causal: row t in a tile sees past_lens + q_start + t + 1 keys.

#if XE_ARCH==1
#define REG_N 8
#define USE_LSC_BLOCK_2D_DESC 0
#else
#define REG_N 16
#define USE_LSC_BLOCK_2D_DESC 1
#endif


#define SystolicDepth 8
#define RepeatCount 1
#define VNNI_WIDTH 2
#define REG_K (SystolicDepth * VNNI_WIDTH)
#define REG_M RepeatCount
#define KV_PARTITION_STEP_NUM  (KV_PARTITION_SIZE / KV_STEP)

// Total q-rows handled by one SG. q_chunk Q-heads share one DPAS row; TILE_Q
// q-tokens stack on top so DPAS RepeatCount = Q_ROWS = Q_head_chunk_size * TILE_Q.
#define Q_ROWS (Q_head_chunk_size * TILE_Q)

#if Q_ROWS > 8
    #if (Q_ROWS % 8) != 0
        #error "Q_ROWS > 8 requires Q_ROWS to be divisible by 8"
    #endif
    #define Q_ROWS_PER_DPAS 8
    #define Q_ROW_GROUPS (Q_ROWS / Q_ROWS_PER_DPAS)
#else
    #define Q_ROWS_PER_DPAS Q_ROWS
    #define Q_ROW_GROUPS 1
#endif

#define ONLINE_TILE_STEPS 1
#define NUM_ONLINE_TILES ((KV_PARTITION_STEP_NUM + ONLINE_TILE_STEPS - 1) / ONLINE_TILE_STEPS)

#if KV_CACHE_COMPRESSION
    #if KV_CACHE_COMPRESSION == 2
    #define GROUPS_PER_BLOCK (KV_BLOCK_SIZE / SUB_BLOCK_SIZE)
    #define K_SCALE_ZP_SIZE (4 * GROUPS_PER_BLOCK)
    #define V_SCALE_ZP_SIZE 4
    #elif KV_CACHE_COMPRESSION == 1
    #define K_SCALE_ZP_SIZE 4
    #define V_SCALE_ZP_SIZE 4
    #endif
    #define KV_ELEMENT_TYPE uint8_t
#else
    #define V_SCALE_ZP_SIZE 0
    #define KV_ELEMENT_TYPE half
#endif

template <typename T1, typename T2>
CM_INLINE void Transpose_8x8(matrix_ref<T1, 8, 8> in, matrix_ref<T2, 8, 8> out) {
    matrix<T2, 8, 8> temp;
    #pragma unroll
    for (int i = 0; i < 4; ++i) {
        temp.row(i)     = in.template select<2, 1, 4, 2>(i * 2, 0);
        temp.row(i + 4) = in.template select<2, 1, 4, 2>(i * 2, 1);
    }

    #pragma unroll
    for (int i = 0; i < 4; ++i) {
        out.row(i * 2)     = temp.template select<4, 1, 2, 4>(0, i);
        out.row(i * 2 + 1) = temp.template select<4, 1, 2, 4>(4, i);
    }
}

// selected_q_mapping is packed as i32 triples:
//   [orig_seq_idx_0, q_start_0, valid_count_0,
//    orig_seq_idx_1, q_start_1, valid_count_1, ...]
// Length = 3 * tile_count. cm_global_id(0) indexes the tile list directly.
extern "C" _GENX_MAIN_ void KERNEL_NAME(
    half* query [[type("svmptr_t")]],
    KV_ELEMENT_TYPE* key [[type("svmptr_t")]],
    KV_ELEMENT_TYPE* value [[type("svmptr_t")]],
    int* past_lens [[type("svmptr_t")]],
    int* block_indices [[type("svmptr_t")]],
    int* block_indices_begins [[type("svmptr_t")]],
    int* subsequence_begins [[type("svmptr_t")]],
    int* selected_q_mapping [[type("svmptr_t")]],
    float* output [[type("svmptr_t")]],
    float* lse [[type("svmptr_t")]],
    int q_len_unused,
    int selected_token_count
    ) {
    // tile_idx indexes the host-packed (orig_seq, q_start, valid_count) triple list.
    // Keep the original global-id path for lws[0]=1, and switch to group-based
    // indexing only when the experimental workgroup-shared path is enabled.
    const uint tile_idx = (cm_local_size(0) > 1) ? cm_group_id(0) : cm_global_id(0);
    const uint local_qg = cm_local_id(0);
    if (tile_idx >= (uint)selected_token_count) {
        return;
    }
    const uint orig_seq_idx = (uint)selected_q_mapping[tile_idx * 3 + 0];
    const uint q_start      = (uint)selected_q_mapping[tile_idx * 3 + 1];
    const uint valid_count  = (uint)selected_q_mapping[tile_idx * 3 + 2];

    const uint kv_head_num_idx = cm_global_id(1) / Q_head_chunks_per_kv_head;
    const uint head_num_idx    = cm_global_id(1) * Q_head_chunk_size;
    const uint wg_thread_id    = cm_global_id(2);
    const uint kv_partition_num = cm_group_count(2);
    const uint kv_partition_idx = cm_group_id(2);

    const int subseq_q_begin_i = subsequence_begins[orig_seq_idx];
    const int subseq_q_end_i   = subsequence_begins[orig_seq_idx + 1];
    if (subseq_q_end_i <= subseq_q_begin_i) {
        return;
    }
    const uint subseq_q_begin = (uint)subseq_q_begin_i;

    // Causal cap: row t sees past + q_start + t + 1 keys. The whole tile uses the
    // largest of these caps to size the partition iteration; per-row masking
    // re-applies the tighter bound on rS columns.
    const uint past_q_lens         = (uint)past_lens[orig_seq_idx];
    const uint kv_len_max          = past_q_lens + q_start + valid_count;       // tile-wide upper bound
    const uint seq_kv_partition_num = (kv_len_max + KV_PARTITION_SIZE - 1) / KV_PARTITION_SIZE;

    const uint block_begin = block_indices_begins[orig_seq_idx];
    const uint block_end   = block_indices_begins[orig_seq_idx + 1];

    const uint blocks_per_partition = (KV_PARTITION_SIZE / KV_BLOCK_SIZE);
    constexpr uint kv_pitch = HEAD_SIZE * sizeof(KV_ELEMENT_TYPE);

    constexpr uint per_v_block_element_num = KV_BLOCK_SIZE * KV_HEADS_NUM * (HEAD_SIZE + V_SCALE_ZP_SIZE);
#if KV_CACHE_COMPRESSION == 1
    constexpr uint per_k_block_element_num = KV_BLOCK_SIZE * KV_HEADS_NUM * (HEAD_SIZE + K_SCALE_ZP_SIZE);
#elif KV_CACHE_COMPRESSION == 2
    constexpr uint per_k_block_element_num = KV_HEADS_NUM * HEAD_SIZE * (KV_BLOCK_SIZE + K_SCALE_ZP_SIZE);
#else
    constexpr uint per_k_block_element_num = KV_BLOCK_SIZE * KV_HEADS_NUM * HEAD_SIZE;
#endif

#if KV_CACHE_COMPRESSION == 1
    if (cm_local_size(0) > 1) {
        if (local_qg >= Q_ROW_GROUPS) {
            return;
        }

        constexpr uint K_CHUNK_BYTES = ONLINE_TILE_STEPS * REG_N * HEAD_SIZE * sizeof(uint8_t);
        constexpr uint V_CHUNK_BYTES = REG_K * HEAD_SIZE * sizeof(uint8_t);
        constexpr uint K_SCALE_BYTES = ONLINE_TILE_STEPS * REG_N * sizeof(half);
        constexpr uint V_SCALE_BYTES = REG_K * sizeof(half);
        cm_slm_init(K_CHUNK_BYTES + V_CHUNK_BYTES + 2 * K_SCALE_BYTES + 2 * V_SCALE_BYTES);
        auto slm_K = cm_slm_alloc(K_CHUNK_BYTES);
        auto slm_V0 = cm_slm_alloc(V_CHUNK_BYTES);
        auto slm_K_scale = cm_slm_alloc(K_SCALE_BYTES);
        auto slm_K_zp = cm_slm_alloc(K_SCALE_BYTES);
        auto slm_V_scale0 = cm_slm_alloc(V_SCALE_BYTES);
        auto slm_V_zp0 = cm_slm_alloc(V_SCALE_BYTES);

        const uint subgroup_row_base = local_qg * Q_ROWS_PER_DPAS;
        matrix<half, Q_ROWS_PER_DPAS, HEAD_SIZE> Qmat_group = 0;
        #if (Q_ROWS_PER_DPAS % Q_head_chunk_size) == 0
        #pragma unroll
        for (int tg = 0; tg < (Q_ROWS_PER_DPAS / Q_head_chunk_size); tg++) {
            const int global_row = subgroup_row_base + tg * Q_head_chunk_size;
            const int t = global_row / Q_head_chunk_size;
            if (t >= (int)valid_count) {
                continue;
            }
            const uint q_token_idx = subseq_q_begin + q_start + t;
            const uint qo_offset = (q_token_idx * HEADS_NUM + head_num_idx) * HEAD_SIZE;
            cm_svm_block_read<half, Q_head_chunk_size * HEAD_SIZE>(
                (svmptr_t)(query + qo_offset),
                Qmat_group.select<Q_head_chunk_size, 1, HEAD_SIZE, 1>(tg * Q_head_chunk_size, 0).format<half>());
        }
        #else
        #pragma unroll
        for (int row = 0; row < Q_ROWS_PER_DPAS; row++) {
            const int global_row = subgroup_row_base + row;
            const int t = global_row / Q_head_chunk_size;
            const int qi = global_row % Q_head_chunk_size;
            if (t >= (int)valid_count) {
                continue;
            }
            const uint q_token_idx = subseq_q_begin + q_start + t;
            const uint qo_offset = (q_token_idx * HEADS_NUM + head_num_idx + qi) * HEAD_SIZE;
            cm_svm_block_read<half, HEAD_SIZE>(
                (svmptr_t)(query + qo_offset),
                Qmat_group.row(row).format<half>());
        }
        #endif

        if (kv_partition_idx >= seq_kv_partition_num) {
            #pragma unroll
            for (int row = 0; row < Q_ROWS_PER_DPAS; row++) {
                const int global_row = subgroup_row_base + row;
                const int t = global_row / Q_head_chunk_size;
                const int qi = global_row % Q_head_chunk_size;
                const uint token_row = tile_idx * TILE_Q + t;
                matrix<float, REG_M, REG_N> zero = 0.0f;
                uint o_offset = token_row * kv_partition_num * HEADS_NUM * HEAD_SIZE
                              + kv_partition_num * (head_num_idx + qi) * HEAD_SIZE
                              + kv_partition_idx * HEAD_SIZE;
                #pragma unroll
                for (int k = 0; k < HEAD_SIZE; k += REG_N) {
                    cm_svm_block_write<float, REG_N>((svmptr_t)(output + o_offset + k), zero.format<float>());
                }
                uint lse_offset = token_row * HEADS_NUM * kv_partition_num
                                + (head_num_idx + qi) * kv_partition_num
                                + kv_partition_idx;
                lse[lse_offset] = -3e38f;
            }
            return;
        }

        const uint start_block_idx = block_begin + kv_partition_idx * blocks_per_partition;
        if (kv_partition_idx * KV_PARTITION_SIZE >= kv_len_max || start_block_idx >= block_end) {
            #pragma unroll
            for (int row = 0; row < Q_ROWS_PER_DPAS; row++) {
                const int global_row = subgroup_row_base + row;
                const int t = global_row / Q_head_chunk_size;
                const int qi = global_row % Q_head_chunk_size;
                const uint token_row = tile_idx * TILE_Q + t;
                matrix<float, REG_M, REG_N> zero = 0.0f;
                uint o_offset = token_row * kv_partition_num * HEADS_NUM * HEAD_SIZE
                              + kv_partition_num * (head_num_idx + qi) * HEAD_SIZE
                              + kv_partition_idx * HEAD_SIZE;
                #pragma unroll
                for (int k = 0; k < HEAD_SIZE; k += REG_N) {
                    cm_svm_block_write<float, REG_N>((svmptr_t)(output + o_offset + k), zero.format<float>());
                }
                uint lse_offset = token_row * HEADS_NUM * kv_partition_num
                                + (head_num_idx + qi) * kv_partition_num
                                + kv_partition_idx;
                lse[lse_offset] = -3e38f;
            }
            return;
        }

        uint block_num = blocks_per_partition;
        if (block_num > block_end - start_block_idx) {
            block_num = block_end - start_block_idx;
        }

        uint leftover_size = 0;
        if (kv_partition_idx == seq_kv_partition_num - 1) {
            leftover_size = (kv_len_max - KV_PARTITION_SIZE * kv_partition_idx) % KV_PARTITION_SIZE;
        }

        constexpr float log2e_wg = 1.4426950408889634f;
        constexpr float loge2_wg = 0.6931471805599453f;
        vector<float, Q_ROWS_PER_DPAS> final_max = -3e38f;
        vector<float, Q_ROWS_PER_DPAS> final_sum = 0.0f;
        matrix<float, Q_ROWS_PER_DPAS, HEAD_SIZE> Omat = 0;

        {
            const uint partition_valid = (leftover_size > 0) ? leftover_size : (uint)KV_PARTITION_SIZE;

            // Precompute per-ki valid span once and reuse across all online tiles.
            vector<uint, KV_PARTITION_STEP_NUM> kv_pos_end_cache = 0;
            #pragma unroll
            for (int ki = 0; ki < KV_PARTITION_STEP_NUM; ki++) {
                uint kv_pos_end_in_block = 0;
                const uint block_idx = ki;
                if (block_idx < block_num) {
                    const uint block_start_in_partition = block_idx * KV_BLOCK_SIZE;
                    if (partition_valid > block_start_in_partition) {
                        kv_pos_end_in_block = partition_valid - block_start_in_partition;
                        if (kv_pos_end_in_block > KV_BLOCK_SIZE) {
                            kv_pos_end_in_block = KV_BLOCK_SIZE;
                        }
                    }
                }
                kv_pos_end_cache[ki] = kv_pos_end_in_block;
            }

            #pragma unroll
            for (int online_tile = 0; online_tile < NUM_ONLINE_TILES; online_tile++) {
                const int ki_base = online_tile * ONLINE_TILE_STEPS;
                matrix<float, Q_ROWS_PER_DPAS, ONLINE_TILE_STEPS * REG_N> rS_tile = 0;
                matrix<half, Q_ROWS_PER_DPAS, ONLINE_TILE_STEPS * REG_N> P_tile = 0;

                if (local_qg == 0) {
                    #pragma unroll
                    for (int li = 0; li < ONLINE_TILE_STEPS; li++) {
                        vector<half, REG_N> k_scale_local = 0.0f;
                        vector<half, REG_N> k_zp_local = 0.0f;
                        const int ki = ki_base + li;
                        if (ki < KV_PARTITION_STEP_NUM) {
                            const uint block_idx = ki;
                            if (block_idx < block_num) {
                                const uint blk_indices = block_indices[start_block_idx + block_idx];
                                const uint k_base_offset = blk_indices * per_k_block_element_num + kv_head_num_idx * (per_k_block_element_num / KV_HEADS_NUM);
                                const uint k_scale_zp_offset = k_base_offset + KV_BLOCK_SIZE * HEAD_SIZE;
                                vector<uint, KV_BLOCK_SIZE> k_scale_zp_block;
                                cm_svm_block_read<uint, KV_BLOCK_SIZE>((svmptr_t)(key + k_scale_zp_offset), k_scale_zp_block);
                                auto k_scale_zp_half = k_scale_zp_block.format<half>();
                                const uint kv_pos_end_in_block = kv_pos_end_cache[ki];

                                #pragma unroll
                                for (int col = 0; col < REG_N; col++) {
                                    if ((uint)col < kv_pos_end_in_block) {
                                        k_scale_local[col] = k_scale_zp_half[col];
                                        k_zp_local[col] = k_scale_zp_half[KV_BLOCK_SIZE + col];
                                    }
                                }
                            }
                        }
                        cm_slm_block_write(slm_K_scale, li * REG_N * sizeof(half), k_scale_local.format<half>());
                        cm_slm_block_write(slm_K_zp, li * REG_N * sizeof(half), k_zp_local.format<half>());
                    }
                }
                // Cooperative K staging for current online tile only.
                #pragma unroll
                for (int flat_row = local_qg; flat_row < ONLINE_TILE_STEPS * REG_N; flat_row += Q_ROW_GROUPS) {
                    const int li = flat_row / REG_N;
                    const int col = flat_row - li * REG_N;
                    const int ki = ki_base + li;
                    vector<uint8_t, HEAD_SIZE> k_row = 0;
                    if (ki < KV_PARTITION_STEP_NUM) {
                        const uint block_idx = ki;
                        if (block_idx < block_num) {
                            const uint blk_indices = block_indices[start_block_idx + block_idx];
                            const uint k_base_offset = blk_indices * per_k_block_element_num + kv_head_num_idx * (per_k_block_element_num / KV_HEADS_NUM);
                            const uint kv_pos_end_in_block = kv_pos_end_cache[ki];
                            if ((uint)col < kv_pos_end_in_block) {
                                cm_svm_block_read<uint8_t, HEAD_SIZE>(
                                    (svmptr_t)(key + k_base_offset + col * HEAD_SIZE),
                                    k_row.format<uint8_t>());
                            }
                        }
                    }
                    cm_slm_block_write(slm_K, (li * REG_N + col) * HEAD_SIZE * sizeof(uint8_t), k_row.format<uint8_t>());
                }
                cm_slm_fence(CM_LOCAL_BARRIER);
                cm_barrier();
                #pragma unroll
                for (int li = 0; li < ONLINE_TILE_STEPS; li++) {
                    const int ki = ki_base + li;
                    if (ki >= KV_PARTITION_STEP_NUM) {
                        continue;
                    }
                    vector<half, REG_N> slm_k_scale;
                    vector<half, REG_N> slm_k_zp;
                    cm_slm_block_read(slm_K_scale, GENX_DWALIGNED, li * REG_N * sizeof(half), slm_k_scale);
                    cm_slm_block_read(slm_K_zp, GENX_DWALIGNED, li * REG_N * sizeof(half), slm_k_zp);

                    for (int k = 0, ri = 0; k < HEAD_SIZE / REG_K; k += 1, ri++) {
                        matrix<uint8_t, REG_N, REG_K> Krows_quant_chunk;
                        #pragma unroll
                        for (int col = 0; col < REG_N; col++) {
                            const uint k_chunk_offset = ((li * REG_N + col) * HEAD_SIZE + ri * REG_K) * sizeof(uint8_t);
                            cm_slm_block_read(slm_K, GENX_DWALIGNED, k_chunk_offset, Krows_quant_chunk.row(col).format<uint8_t>());
                        }
                        matrix<half, REG_K, REG_N> Kt = 0;
                        matrix<half, REG_N, REG_K> KtNormal = 0;
                        #pragma unroll
                        for (int col = 0; col < REG_N; col++) {
                            KtNormal.row(col) = Krows_quant_chunk.row(col);
                            KtNormal.row(col) = KtNormal.row(col) - slm_k_zp[col];
                            KtNormal.row(col) = cm_mul<half>(KtNormal.row(col), slm_k_scale[col]);
                        }
#if XE_ARCH==1
                        Transpose_8x8(KtNormal.format<uint, REG_N, REG_K/2>(), Kt.format<uint, REG_K/2, REG_N>());
#else
                        Transpose_8x8(
                            KtNormal.format<uint, REG_N, REG_K/2>().select<8,1,8,1>(0,0),
                            Kt.format<uint, REG_K/2, REG_N>().select<8,1,8,1>(0,0));
                        Transpose_8x8(
                            KtNormal.format<uint, REG_N, REG_K/2>().select<8,1,8,1>(8,0),
                            Kt.format<uint, REG_K/2, REG_N>().select<8,1,8,1>(0,8));
#endif
                        matrix<half, Q_ROWS_PER_DPAS, REG_K> Qmat_data = Qmat_group.select<Q_ROWS_PER_DPAS,1,REG_K,1>(0, ri * REG_K);
                        matrix<float, Q_ROWS_PER_DPAS, REG_N> rS_data = 0;
                        rS_data = cm_dpas<CM_PRECISION_HF, CM_PRECISION_HF, SystolicDepth, Q_ROWS_PER_DPAS>(
                                    rS_data.format<float>(),
                                    Kt.format<int32_t>(),
                                    Qmat_data.format<int32_t>());
                        rS_tile.select<Q_ROWS_PER_DPAS, 1, REG_N, 1>(0, li * REG_N) += rS_data;
                    }
                }

                rS_tile = cm_mul<float>(rS_tile, (float)SCALE_FACTOR);

                {
                    const int kv_global_start = (int)(kv_partition_idx * KV_PARTITION_SIZE);
                    vector<int, REG_N> col_index;
                    #pragma unroll
                    for (int c = 0; c < REG_N; ++c) col_index[c] = c;
                    const float NEG_INF = -3.4e38f;

                    #pragma unroll
                    for (int row = 0; row < Q_ROWS_PER_DPAS; ++row) {
                        const int global_row = subgroup_row_base + row;
                        const int t = global_row / Q_head_chunk_size;
                        const int kv_len_t = (t < (int)valid_count) ? (int)(past_q_lens + q_start + t + 1) : 0;
                        const int row_kv_in_partition = kv_len_t - kv_global_start;
                        const int mask_from = row_kv_in_partition > 0 ? row_kv_in_partition : 0;
                        auto rs_row = rS_tile[row].format<float, ONLINE_TILE_STEPS, REG_N>();
                        #pragma unroll
                        for (int b = 0; b < ONLINE_TILE_STEPS; ++b) {
                            const int blk_lo = (ki_base + b) * REG_N;
                            if (blk_lo >= mask_from) {
                                rs_row.row(b) = NEG_INF;
                            } else if (blk_lo + REG_N > mask_from) {
                                vector<unsigned short, REG_N> m = col_index >= (mask_from - blk_lo);
                                auto blk = rs_row.row(b);
                                blk.merge(NEG_INF, m);
                            }

                            if (blk_lo >= (int)partition_valid) {
                                rs_row.row(b) = NEG_INF;
                            } else if (blk_lo + REG_N > (int)partition_valid) {
                                vector<unsigned short, REG_N> m2 = col_index >= ((int)partition_valid - blk_lo);
                                auto blk2 = rs_row.row(b);
                                blk2.merge(NEG_INF, m2);
                            }
                        }
                    }
                }

                #pragma unroll
                for (int row = 0; row < Q_ROWS_PER_DPAS; row++) {
                    auto rS_row = rS_tile[row].format<float>();
#if XE_ARCH==1
                    float tile_max = cm_reduced_max<float>(rS_row);
#else
                    float tile_max = rS_row[0];
                    #pragma unroll
                    for (int r = 1; r < rS_row.n_elems(); r++)
                        tile_max = cm_max<float>(tile_max, rS_row[r]);
#endif
                    float new_max = cm_max<float>(final_max[row], tile_max);
                    float correction = cm_exp((final_max[row] - new_max) * log2e_wg);
                    final_sum[row] *= correction;
                    Omat.row(row) *= correction;

                    vector<float, ONLINE_TILE_STEPS * REG_N> exp_vals = cm_exp((rS_row - new_max) * log2e_wg);
                    final_sum[row] += cm_sum<float>(exp_vals);
                    final_max[row] = new_max;
                    P_tile[row] = exp_vals;
                }

                #pragma unroll
                for (int li_v = 0; li_v < ONLINE_TILE_STEPS; li_v++) {
                    const int ki = ki_base + li_v;
                    if (ki >= KV_PARTITION_STEP_NUM) {
                        continue;
                    }

                    bool block_valid = false;
                    uint v_base_offset = 0;
                    uint kv_pos_end_in_block = 0;
                    const uint block_idx = ki;
                    if (block_idx < block_num) {
                        block_valid = true;
                        const uint blk_indices = block_indices[start_block_idx + block_idx];
                        v_base_offset = blk_indices * per_v_block_element_num + kv_head_num_idx * (per_v_block_element_num / KV_HEADS_NUM);
                        kv_pos_end_in_block = kv_pos_end_cache[ki];

                        if (local_qg == 0) {
                            vector<half, REG_K> v_scale_local = 0.0f;
                            vector<half, REG_K> v_zp_local = 0.0f;
                            const uint v_scale_zp_offset = v_base_offset + KV_BLOCK_SIZE * HEAD_SIZE;
                            vector<uint, KV_BLOCK_SIZE> v_scale_zp_block;
                            cm_svm_block_read<uint, KV_BLOCK_SIZE>((svmptr_t)(value + v_scale_zp_offset), v_scale_zp_block);
                            auto v_scale_zp_half = v_scale_zp_block.format<half>();
                            #pragma unroll
                            for (int r = 0; r < REG_K; r++) {
                                if ((uint)r < kv_pos_end_in_block) {
                                    v_scale_local[r] = v_scale_zp_half[r];
                                    v_zp_local[r] = v_scale_zp_half[KV_BLOCK_SIZE + r];
                                }
                            }
                            cm_slm_block_write(slm_V_scale0, 0, v_scale_local.format<half>());
                            cm_slm_block_write(slm_V_zp0, 0, v_zp_local.format<half>());
                        }
                    } else if (local_qg == 0) {
                        vector<half, REG_K> v_scale_local = 0.0f;
                        vector<half, REG_K> v_zp_local = 0.0f;
                        cm_slm_block_write(slm_V_scale0, 0, v_scale_local.format<half>());
                        cm_slm_block_write(slm_V_zp0, 0, v_zp_local.format<half>());
                    }

                    #pragma unroll
                    for (int r = local_qg; r < REG_K; r += Q_ROW_GROUPS) {
                        vector<uint8_t, HEAD_SIZE> v_row = 0;
                        if (block_valid && (uint)r < kv_pos_end_in_block) {
                            cm_svm_block_read<uint8_t, HEAD_SIZE>(
                                (svmptr_t)(value + v_base_offset + r * HEAD_SIZE),
                                v_row.format<uint8_t>());
                        }
                        cm_slm_block_write(slm_V0, r * HEAD_SIZE * sizeof(uint8_t), v_row.format<uint8_t>());
                    }

                    cm_slm_fence(CM_LOCAL_BARRIER);
                    cm_barrier();
                    vector<half, REG_K> slm_v_scale;
                    vector<half, REG_K> slm_v_zp;
                    cm_slm_block_read(slm_V_scale0, GENX_DWALIGNED, 0, slm_v_scale);
                    cm_slm_block_read(slm_V_zp0, GENX_DWALIGNED, 0, slm_v_zp);

                    matrix<half, Q_ROWS_PER_DPAS, REG_K> Pmat_data =
                        P_tile.select<Q_ROWS_PER_DPAS, 1, REG_K, 1>(0, li_v * REG_N);

                    for (int k = 0, ri = 0; k < HEAD_SIZE; k += REG_N, ri++) {
                        matrix<uint8_t, REG_K, REG_N> Vrows_quant_chunk;
                        #pragma unroll
                        for (int r = 0; r < REG_K; r++) {
                            const uint v_chunk_offset = (r * HEAD_SIZE + k) * sizeof(uint8_t);
                            cm_slm_block_read(slm_V0, GENX_DWALIGNED, v_chunk_offset, Vrows_quant_chunk.row(r).format<uint8_t>());
                        }
                        matrix<half, REG_K, REG_N> VmatNormal;
                        #pragma unroll
                        for (int r = 0; r < REG_K; r++) {
                            const int kv_row = r;
                            VmatNormal[r] = Vrows_quant_chunk.row(r);
                            VmatNormal[r] = VmatNormal[r] - slm_v_zp[kv_row];
                            VmatNormal[r] = cm_mul<half>(VmatNormal[r], slm_v_scale[kv_row]);
                        }
                        matrix<half, REG_K/2, REG_N*2> Vmat;
                        auto Vref = Vmat.format<half, REG_K/2, REG_N*2>();
                        Vref.select<REG_K/2, 1, REG_N, 2>(0, 0) = VmatNormal.select<REG_K/2, 2, REG_N, 1>(0, 0);
                        Vref.select<REG_K/2, 1, REG_N, 2>(0, 1) = VmatNormal.select<REG_K/2, 2, REG_N, 1>(1, 0);

                        auto Omat_data = Omat.select<Q_ROWS_PER_DPAS,1,REG_N,1>(0, ri * REG_N);
                        Omat_data = cm_dpas<CM_PRECISION_HF, CM_PRECISION_HF, SystolicDepth, Q_ROWS_PER_DPAS>(
                                    Omat_data.format<float>(),
                                    Vmat.format<int32_t>(),
                                    Pmat_data.format<int32_t>());
                    }
                }
            }
        }

        vector<float, Q_ROWS_PER_DPAS> cur_lse;
        #pragma unroll
        for (int row = 0; row < Q_ROWS_PER_DPAS; row++) {
            cur_lse[row] = (final_sum[row] > 0.0f)
                           ? (cm_log<float>(final_sum[row]) * loge2_wg + final_max[row])
                           : -3e38f;
        }

        #pragma unroll
        for (int row = 0; row < Q_ROWS_PER_DPAS; row++) {
            const int global_row = subgroup_row_base + row;
            const int t = global_row / Q_head_chunk_size;
            const int qi = global_row % Q_head_chunk_size;
            const uint token_row = tile_idx * TILE_Q + t;
            const bool row_valid = (t < (int)valid_count);
            matrix<float, REG_M, REG_N> cur_O_f32;
            uint o_offset = token_row * kv_partition_num * HEADS_NUM * HEAD_SIZE
                          + kv_partition_num * (head_num_idx + qi) * HEAD_SIZE
                          + kv_partition_idx * HEAD_SIZE;
            float div_cur_sum = (row_valid && final_sum[row] > 0.0f) ? (1.0f / final_sum[row]) : 0.0f;
            auto Omat_slice = Omat[row].format<float, HEAD_SIZE/REG_N * REG_M, REG_N>();
            #pragma unroll
            for (int k = 0, ri = 0; k < HEAD_SIZE; k += REG_N, ri++) {
                auto cO = Omat_slice[ri].format<float, REG_M, REG_N>();
#if XE_ARCH==1
                cur_O_f32 = row_valid && final_sum[row] > 0.0f ? cm_mul<float>(cO, div_cur_sum) : 0.0f;
#else
                cur_O_f32 = row_valid && final_sum[row] > 0.0f ? cm_div_ieee(cO, final_sum[row]) : 0.0f;
#endif
                cm_svm_block_write<float, REG_N>((svmptr_t)(output + o_offset + k), cur_O_f32.format<float>());
            }
            uint lse_offset = token_row * HEADS_NUM * kv_partition_num
                            + (head_num_idx + qi) * kv_partition_num
                            + kv_partition_idx;
            lse[lse_offset] = (row_valid && final_sum[row] > 0.0f) ? cur_lse[row] : -3e38f;
        }
        return;
    }
#endif
    }
}  // namespace KERNEL_NAME
